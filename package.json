{
  "name": "voicedub-arena",
  "version": "1.0.0",
  "description": "Choicer Voicer clone web application",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "backend": "cd backend && npm run start",
    "frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "voiceover",
    "dubbing"
  ],
  "author": "Antigravity & Sebastian",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
